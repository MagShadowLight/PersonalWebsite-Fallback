{
	"name": "fallback-portfolio",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"routes": [
		{ "pattern": "magshadowlight.com/*", "zone_name": "magshadowlight.com" }
	],
	"workers_dev": false,
  	"observability": {
    		"logs": {
      			"enabled": true,
      			"head_sampling_rate": 1,
      			"invocation_logs": true,
      			"persist": true
    		},
    		"traces": {
      			"enabled": false,
      			"head_sampling_rate": 1,
      			"persist": true
    		},
    		"issue_detection": {
      			"enabled": false
    		}
  	},
	"assets" : {
		"directory": "./_site",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/*",
			"!/*.js", "!/*.css", "!/*.png", "!/*.jpg", "!/*.jpeg",
			"!/*.webp", "!/*.svg", "!/*.ico", "!/*.woff", "!/*.woff2",
			"!/fallback/*"
		]
	}
}
