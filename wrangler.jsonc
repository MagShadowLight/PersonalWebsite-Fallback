{
	"name": "fallback-portfolio",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"routes": [
		{ "pattern": "magshadowlight.com/*", "zone_name": "magshadowlight.com" }
	],
	"workers_dev": false,
  	"observability": {
    		"enabled": true
  	},
	"assets" : {
		"directory": "./_site",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/*",
			"!/*.js", "!/*.css",
			"!/*.webp", "!/*.svg", "!/*.ico", "!/*.woff", "!/*.woff2",
			"!/fallback/*"
		]
	}
}
